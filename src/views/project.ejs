<%- include('partials/header') %>

    <main>
        <h1><%= project.title %></h1>
        <section>
            <h2>Project</h2>
            <p><%= project.description %></p>
            <p><strong>Date:</strong> <%= project.project_date %></p>
            <p><strong>Location:</strong> <%= project.project_location %></p>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </section>
        <section>
            <h2>Categories</h2>
            <article>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category %>
                    </a>
                <% }); %>
            </article>
        </section>
        <p>
            <% if (user && user.role_name === 'admin') { %>
                <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
            <% } %>
            <% if (user && user.role_name === 'admin') { %>
                <a href="/edit-project/<%= project.project_id %>"> Edit Project </a>
            <% } %>
        </p>
        <% if (user && !volunteer) { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
        <% if (user && volunteer) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/volunteer/remove" method="POST">
                <button type="submit">Remove yourself as a volunteer</button>
            </form>
        <% } %>
        </main>

<%- include('partials/footer') %>