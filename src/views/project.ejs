<%- include('partials/header') %>

    <main>
        <h1><%= project.title %></h1>
        <section>
            <h2>Project</h2>
            <p><%= project.description %></p>
            <p><strong>Date:</strong> <%= project.project_date %></p>
            <p><strong>Location:</strong> <%= project.project_location %></p>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </section>
        <section>
            <h2>Categories</h2>
            <article>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category %>
                    </a>
                <% }); %>
            </article>
        </section>
    </main>

<%- include('partials/footer') %>