<%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
        <form action="/new-project" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" maxlength="150" required />
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required></textarea>
            </div>
            <div class="form-group">
                <label for="project_location">Location</label>
                <input type="text" id="project_location" name="project_location" maxlength="255" required />
            </div>
            <div class="form-group">
                <label for="project_date">Date</label>
                <input type="date" id="project_date" name="project_date" required />
            </div>
            <div class="form-group">
                <label for="organization_id">Organization</label>
                <select id="organization_id" name="organization_id" required >
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>"><%= org.organization_name %></option>
                    <% }); %>
                </select>
            </div>
            <button type="submit">Create Project</button>
        </form>
    </main>

<%- include('partials/footer') %>