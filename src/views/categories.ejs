<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <ul class="categories_box">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category %>
                    </a>
                </li>
            <% }); %>
        </ul>
        <p>
            <% if (user && user.role_name === 'admin') { %>
                <a href="/new-category">Add New Category</a>
            <% } %>
        </p>
    </main>

<%- include('partials/footer') %>